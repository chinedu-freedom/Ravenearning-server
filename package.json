{
  "name": "omni-backend",
  "version": "1.0.0",
  "description": "Backend API",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon src/main.js",
    "build": "prisma generate && prisma db push --accept-data-loss",
