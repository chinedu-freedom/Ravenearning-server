    "db:push": "prisma db push --accept-data-loss",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "axios": "^1.18.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
